  <property name="styleSheet">
   <string notr="true">* {
	margin: 0;
	padding: 0;
	border: none;
	background: none;
	color: #fff;
}
#leftContainer {
	background-color: rgb(85, 85, 255);
	color: #fff;
}
#leftContainer QPushButton {
	text-align: left;
	padding: 10px 20px;
	color: #fff;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
}
#leftContainer QPushButton:hover {
	background-color: rgba(255, 255, 255, .1);
}

#headerConteiner {
	background-color: rgb(85, 85, 255);
	color: #fff;
	border-radius: 10px;
}
#searchTxt {
	border-radius: 5px;
	padding: 4px 10px;
	background: none;
	background-color: rgb(90, 90, 255);
	color: #fff;
	border-bottom: 1px solid #fff;
}
#searchBtn {
	background-color: rgb(85, 170, 255);
	padding: 6px 10px;
	border-radius: 5px;
}
#changeUserPage Qlabel {
	color: #000;
}

#leftContainer QComboBox {
	text-align: left;
	padding: 10px 20px;
	border-radius: 10px;
    margin: 5px;
background-color:white;

}
#DashboardWindow {
background-image: url(:/resources/images/images/1.jpeg);
}</string>
